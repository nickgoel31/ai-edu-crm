datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan                 String  @default("SELF_SERVE")
  subscriptionStatus   String  @default("ACTIVE")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  onboardingDismissed  Boolean @default(false)

  users                   User[]
  leads                   Lead[]
  students                Student[]
  agents                  Agent[]
  auditLogs               AuditLog[]
  activities              Activity[]
  integrations            Integration[]
  documentTemplates       DocumentTemplate[]
  erpSyncLogs             ErpSyncLog[]
  notificationPreferences NotificationPreference[]
  agentTriggers           AgentTrigger[]
  agentTriggerFires       AgentTriggerFire[]
  customFieldDefinitions  CustomFieldDefinition[]
  customFieldValues       CustomFieldValue[]
  tags                    Tag[]
  entityTags              EntityTag[]
  duplicateMatches        DuplicateMatch[]
  scoringRules            ScoringRule[]
  slaPolicies             SLAPolicy[]
  pipelineTemplates       PipelineTemplate[]
  messageTemplates        MessageTemplate[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  password       String
  role           String   @default("COUNSELOR")
  name           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedLeads          Lead[]                  @relation("AssignedLeads")
  auditLogs              AuditLog[]
  activities             Activity[]
  claimedConversations   Conversation[]          @relation("ClaimedConversations")
  notificationPreference NotificationPreference?

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Lead {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  phone            String
  email            String
  source           String
  program          String?        // Optional specific program (e.g. "Data Science", "Electric Vehicle")
  stage            String   @default("COLD")
  pipelineStageId  String?        // Foreign key to dynamic PipelineStage
  lostReason       String?
  assignedToUserId String?
  score            Int?
  scoreBreakdown   String?        // JSON string breakdown of contributing rules
  slaDueBy         DateTime?      // Target response deadline computed on lead creation
  firstContactAt   DateTime?      // Timestamp when first contact/activity was logged
  slaBreached      Boolean        @default(false)
  isArchived       Boolean        @default(false)
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo    User?          @relation("AssignedLeads", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  pipelineStage PipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  students      Student[]
  conversations Conversation[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, pipelineStageId])
  @@index([organizationId, isArchived])
  @@index([organizationId, slaDueBy])
  @@index([organizationId, firstContactAt])
  @@map("leads")
}

model Student {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String?
  name           String
  phone          String
  email          String
  stage          String   @default("ENQUIRY")
  program        String
  cohort         String
  branch         String?
  externalId     String?
  attendance     String?
  examResults    String?
  isArchived     Boolean  @default(false)
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  documents     Document[]
  payments      Payment[]
  conversations Conversation[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, externalId])
  @@index([organizationId, isArchived])
  @@map("students")
}

model Document {
  id        String   @id @default(cuid())
  studentId String
  name      String
  status    String   @default("PENDING")
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("documents")
}

model Payment {
  id                String   @id @default(cuid())
  studentId         String
  amount            Float
  dueDate           DateTime
  status            String   @default("PENDING")
  installmentNumber Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("payments")
}

model Agent {
  id                String   @id @default(cuid())
  organizationId    String
  channel           String
  role              String
  category          String
  name              String
  status            String   @default("LIVE")
  config            String
  outboundWebhookUrl String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  triggers      AgentTrigger[]
  triggerFires  AgentTriggerFire[]

  @@index([organizationId])
  @@map("agents")
}

model AgentTrigger {
  id             String   @id @default(cuid())
  organizationId String
  agentId        String
  triggerEvent   String
  conditions     String? // serialized JSON, e.g. { "daysThreshold": 3 }
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fires        AgentTriggerFire[]

  @@index([organizationId])
  @@index([agentId])
  @@index([organizationId, triggerEvent])
  @@map("agent_triggers")
}

// One row per (agentTrigger, entity) pair. Used both as the cooldown ledger
// (lastTriggeredAt) and as the fire history shown on the Agent Automation tab.
model AgentTriggerFire {
  id             String   @id @default(cuid())
  organizationId String
  agentTriggerId String
  agentId        String
  entityType     String // "LEAD" | "STUDENT" | "CONVERSATION"
  entityId       String
  status         String   @default("SUCCESS") // "SUCCESS" | "FAILED" | "SKIPPED"
  errorMessage   String?
  lastTriggeredAt DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentTrigger AgentTrigger @relation(fields: [agentTriggerId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentTriggerId, entityType, entityId])
  @@index([organizationId])
  @@index([agentId])
  @@index([entityType, entityId])
  @@map("agent_trigger_fires")
}

model Conversation {
  id              String    @id @default(cuid())
  agentId         String
  leadId          String?
  studentId       String?
  channel         String
  transcript      String
  outcome         String    @default("CONTINUED")
  costInPaise     Int?
  claimedByUserId String?
  claimedAt       DateTime?
  createdAt       DateTime  @default(now())

  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  claimedBy User?    @relation("ClaimedConversations", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([leadId])
  @@index([studentId])
  @@index([claimedByUserId])
  @@map("conversations")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  changesJson    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Activity {
  id              String   @id @default(cuid())
  organizationId  String
  entityType      String
  entityId        String
  type            String
  content         String?
  metadata        String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, entityType, entityId, createdAt])
  @@map("activities")
}

model Integration {
  id             String    @id @default(cuid())
  organizationId String
  type           String
  isEnabled      Boolean   @default(true)
  webhookSecret  String
  config         String?
  lastSyncAt     DateTime?
  lastSyncStatus String?
  lastError      String?
  leadsImported  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
  @@index([organizationId])
  @@index([webhookSecret])
  @@map("integrations")
}

model DocumentTemplate {
  id                String   @id @default(cuid())
  organizationId    String
  program           String
  requiredDocuments String // serialized JSON string array e.g. ["Aadhaar Card", "10th Certificate"]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, program])
  @@index([organizationId])
  @@map("document_templates")
}

model ErpSyncLog {
  id             String   @id @default(cuid())
  organizationId String
  direction      String
  action         String
  status         String
  entityId       String?
  payload        String?
  response       String?
  errorMessage   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, direction])
  @@index([organizationId, createdAt])
  @@map("erp_sync_logs")
}

model NotificationPreference {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  organizationId          String
  stalledLeadsInApp       Boolean  @default(true)
  stalledLeadsEmail       Boolean  @default(true)
  stalledLeadsWhatsapp    Boolean  @default(false)
  overduePaymentsInApp    Boolean  @default(true)
  overduePaymentsEmail    Boolean  @default(true)
  overduePaymentsWhatsapp Boolean  @default(false)
  escalationsInApp        Boolean  @default(true)
  escalationsEmail        Boolean  @default(false)
  escalationsWhatsapp     Boolean  @default(true)
  preferredChannel        String   @default("EMAIL") // "EMAIL" | "WHATSAPP"
  whatsappNumber          String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("notification_preferences")
}

model CustomFieldDefinition {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String   // "LEAD" | "STUDENT"
  fieldKey       String
  label          String
  fieldType      String   // "TEXT" | "NUMBER" | "DATE" | "SELECT" | "BOOLEAN"
  options        String?  // JSON string array for SELECT options e.g. ["Option 1", "Option 2"]
  required       Boolean  @default(false)
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       CustomFieldValue[]

  @@unique([organizationId, entityType, fieldKey])
  @@index([organizationId])
  @@index([organizationId, entityType, isActive])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id                String   @id @default(cuid())
  organizationId    String
  entityType        String   // "LEAD" | "STUDENT"
  entityId          String   // Lead ID or Student ID
  fieldDefinitionId String
  value             String?  // Stored as string, cast on read
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fieldDefinition CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([fieldDefinitionId, entityId])
  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@map("custom_field_values")
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#3b82f6") // Hex color e.g. #3b82f6, #10b981, #f59e0b
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityTags   EntityTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tags")
}

model EntityTag {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String   // "LEAD" | "STUDENT"
  entityId       String   // Lead ID or Student ID
  tagId          String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, entityId, tagId])
  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([tagId])
  @@map("entity_tags")
}

model DuplicateMatch {
  id                String   @id @default(cuid())
  organizationId    String
  entityType        String   // "LEAD" | "STUDENT"
  primaryEntityId   String
  duplicateEntityId String
  matchedOn         String   @default("phone") // "phone" | "email"
  status            String   @default("PENDING") // "PENDING" | "MERGED" | "DISMISSED"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, primaryEntityId, duplicateEntityId])
  @@index([organizationId, entityType, status])
  @@index([organizationId, primaryEntityId])
  @@index([organizationId, duplicateEntityId])
  @@map("duplicate_matches")
}

model ScoringRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  field          String   // "source" | "stage" | "daysInCurrentStage" | "daysSinceLastActivity" | "hasReplied" | "hasConversations" | custom field key
  operator       String   // "EQUALS" | "NOT_EQUALS" | "GREATER_THAN" | "LESS_THAN" | "CONTAINS"
  value          String   // comparison target value
  points         Int      // positive or negative points, e.g. +20, -15
  enabled        Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, enabled])
  @@map("scoring_rules")
}

model SLAPolicy {
  id                   String   @id @default(cuid())
  organizationId       String
  source               String?  // null indicates org-wide default fallback SLA, or enum LeadSource string
  respondWithinMinutes Int      // e.g. 15, 30, 60, 120, 240
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, source])
  @@index([organizationId])
  @@map("sla_policies")
}

model PipelineTemplate {
  id             String          @id @default(cuid())
  organizationId String
  name           String          // e.g. "Default Admissions Pipeline", "Vocational Diploma Pipeline"
  program        String?         // null indicates default fallback template for leads without specific program
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages         PipelineStage[]

  @@unique([organizationId, program])
  @@index([organizationId])
  @@map("pipeline_templates")
}

model PipelineStage {
  id                   String           @id @default(cuid())
  pipelineTemplateId   String
  name                 String           // e.g. "Inbound Inquiry", "Document Verification", "Seat Blocked"
  displayOrder         Int              @default(0)
  color                String           @default("#3b82f6") // Hex color e.g. "#3b82f6"
  requiresReasonOnExit Boolean          @default(false)     // If true, exiting this stage prompts for a reason
  mapsToBucket         String           // "COLD" | "WARM" | "HOT" | "CONVERTING" | "LOST"
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  pipelineTemplate     PipelineTemplate @relation(fields: [pipelineTemplateId], references: [id], onDelete: Cascade)
  leads                Lead[]

  @@index([pipelineTemplateId])
  @@index([pipelineTemplateId, displayOrder])
  @@map("pipeline_stages")
}

model MessageTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  channel        String   // "EMAIL" | "SMS" | "WHATSAPP"
  subject        String?  // Only for EMAIL channel
  body           String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, channel])
  @@map("message_templates")
}
