datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan                 String    @default("SELF_SERVE")
  subscriptionStatus   String    @default("ACTIVE")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  // Set on signup to now+14d; cleared once a real Stripe subscription
  // activates. lib/billing/access.ts reads this to gate AI-agent usage
  // once a trial has run out with no active subscription behind it.
  trialEndsAt          DateTime?
  onboardingDismissed  Boolean   @default(false)

  // SAML SSO (see lib/sso/saml.ts). ssoDomain drives email-domain-based
  // IdP discovery on the login page. ssoCert is the IdP's public signing
  // certificate — not a secret, so stored as-is (unlike agent/ERP secrets).
  ssoEnabled    Boolean @default(false)
  ssoDomain     String? @unique
  ssoEntryPoint String?
  ssoIssuer     String?
  ssoCert       String?

  // Multi-branch / franchise white-labelling. A branch org has
  // parentOrganizationId set to its franchise HQ; the HQ (parent) sees a
  // roll-up across every branch (lib/vendor-admin.ts-style aggregation, see
  // app/franchise/page.tsx), while each branch only ever sees its own data
  // through the normal scoped-prisma tenant isolation.
  parentOrganizationId String?
  brandLogoUrl         String?
  brandPrimaryColor    String? // hex, e.g. "#2563eb" — applied as --primary-brand on the branch's login/portal pages
  // UPI VPA (e.g. "coaching@okhdfcbank") fee reminders and referral payouts
  // build upi://pay deep links against. Optional — features degrade to a
  // plain payment-link placeholder when unset.
  upiVpa               String?

  parentOrganization Organization?  @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  branches           Organization[] @relation("OrgHierarchy")

  users                   User[]
  leads                   Lead[]
  students                Student[]
  agents                  Agent[]
  auditLogs               AuditLog[]
  activities              Activity[]
  integrations            Integration[]
  documentTemplates       DocumentTemplate[]
  erpSyncLogs             ErpSyncLog[]
  notificationPreferences NotificationPreference[]
  agentTriggers           AgentTrigger[]
  agentTriggerFires       AgentTriggerFire[]
  customFieldDefinitions  CustomFieldDefinition[]
  customFieldValues       CustomFieldValue[]
  tags                    Tag[]
  entityTags              EntityTag[]
  duplicateMatches        DuplicateMatch[]
  scoringRules            ScoringRule[]
  slaPolicies             SLAPolicy[]
  pipelineTemplates       PipelineTemplate[]
  messageTemplates        MessageTemplate[]
  knowledgeBases          KnowledgeBase[]
  batches                 Batch[]
  classAttendance         ClassAttendance[]
  guardians               Guardian[]
  demoSlots               DemoSlot[]
  demoBookings            DemoBooking[]
  referralPayouts         ReferralPayout[]
  broadcastCampaigns      BroadcastCampaign[]

  @@map("organizations")
}

model User {
  id                   String   @id @default(cuid())
  organizationId       String
  email                String
  password             String
  role                 String   @default("COUNSELOR")
  name                 String?
  // TOTP two-factor auth. Secret is encrypted at rest (lib/crypto.ts);
  // backupCodes is a JSON array of bcrypt hashes, each single-use.
  twoFactorSecret      String?
  twoFactorEnabled     Boolean  @default(false)
  twoFactorBackupCodes String?
  // Per-user module access override, e.g. {"leads":true,"students":false}.
  // Null = full access to every module their role can otherwise reach
  // (today's default behavior, unchanged for every existing user).
  // ADMIN is never restricted by this — see lib/rbac.ts.
  moduleAccess         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedLeads          Lead[]                  @relation("AssignedLeads")
  auditLogs              AuditLog[]
  activities             Activity[]
  claimedConversations   Conversation[]          @relation("ClaimedConversations")
  notificationPreference NotificationPreference?
  facultyBatches         Batch[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Lead {
  id               String    @id @default(cuid())
  organizationId   String
  name             String
  phone            String
  email            String
  source           String
  program          String? // Optional specific program (e.g. "Data Science", "Electric Vehicle")
  stage            String    @default("COLD")
  pipelineStageId  String? // Foreign key to dynamic PipelineStage
  lostReason       String?
  assignedToUserId String?
  score            Int?
  scoreBreakdown   String? // JSON string breakdown of contributing rules
  slaDueBy         DateTime? // Target response deadline computed on lead creation
  firstContactAt   DateTime? // Timestamp when first contact/activity was logged
  slaBreached      Boolean   @default(false)
  isArchived       Boolean   @default(false)
  archivedAt       DateTime?
  // DLT/opt-in consent for WhatsApp broadcast campaigns (see
  // lib/broadcast.ts) — separate from ordinary 1:1 agent conversations,
  // which don't require marketing opt-in under Indian DLT rules.
  whatsappOptIn    Boolean   @default(false)
  whatsappOptInAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo      User?            @relation("AssignedLeads", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  pipelineStage   PipelineStage?   @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  students        Student[]
  conversations   Conversation[]
  demoBookings    DemoBooking[]
  referralPayouts ReferralPayout[] @relation("ReferredLead")

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, pipelineStageId])
  @@index([organizationId, isArchived])
  @@index([organizationId, slaDueBy])
  @@index([organizationId, firstContactAt])
  @@map("leads")
}

model Student {
  id                 String    @id @default(cuid())
  organizationId     String
  leadId             String?
  batchId            String?
  name               String
  phone              String
  email              String
  stage              String    @default("ENQUIRY")
  program            String
  cohort             String
  branch             String?
  externalId         String?
  attendance         String?
  examResults        String?
  isArchived         Boolean   @default(false)
  archivedAt         DateTime?
  whatsappOptIn      Boolean   @default(false)
  whatsappOptInAt    DateTime?
  // Dropout/churn-risk scoring (lib/churn-scoring.ts) — same rule-based
  // pattern as Lead.score/scoreBreakdown, but for already-enrolled students:
  // attendance decline, payment overdue, low test scores, etc.
  churnRiskScore     Int?
  churnRiskFactors   String? // JSON breakdown, same shape as Lead.scoreBreakdown
  churnRiskUpdatedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead                Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  batch               Batch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  documents           Document[]
  payments            Payment[]
  conversations       Conversation[]
  guardians           Guardian[]
  attendanceRecords   ClassAttendance[]
  referralPayoutsMade ReferralPayout[]  @relation("ReferrerStudent")

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, externalId])
  @@index([organizationId, isArchived])
  @@index([organizationId, batchId])
  @@map("students")
}

model Document {
  id        String   @id @default(cuid())
  studentId String
  name      String
  status    String   @default("PENDING")
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("documents")
}

model Payment {
  id                String   @id @default(cuid())
  studentId         String
  amount            Float
  dueDate           DateTime
  status            String   @default("PENDING")
  installmentNumber Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("payments")
}

model Agent {
  id                 String   @id @default(cuid())
  organizationId     String
  channel            String
  role               String
  category           String
  name               String
  status             String   @default("LIVE")
  config             String
  outboundWebhookUrl String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  triggers       AgentTrigger[]
  triggerFires   AgentTriggerFire[]
  knowledgeBases AgentKnowledgeBase[]

  @@index([organizationId])
  @@map("agents")
}

// A reusable, org-wide knowledge source (FAQs, program info, policies).
// Any agent in the org can be attached to any knowledge base — attachment is
// a many-to-many join (AgentKnowledgeBase) so the same KB can back multiple
// agents at once (e.g. the same "Programs & Fees" KB feeding both the
// WhatsApp Lead Qualification agent and the Website Live Guide).
model KnowledgeBase {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    KnowledgeBaseDocument[]
  agents       AgentKnowledgeBase[]

  @@index([organizationId])
  @@map("knowledge_bases")
}

model KnowledgeBaseDocument {
  id              String   @id @default(cuid())
  knowledgeBaseId String
  title           String
  sourceType      String   @default("TEXT") // "TEXT" | "URL"
  content         String // raw text content, or the URL when sourceType = "URL"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
  @@map("knowledge_base_documents")
}

model AgentKnowledgeBase {
  id              String   @id @default(cuid())
  agentId         String
  knowledgeBaseId String
  createdAt       DateTime @default(now())

  agent         Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@unique([agentId, knowledgeBaseId])
  @@index([agentId])
  @@index([knowledgeBaseId])
  @@map("agent_knowledge_bases")
}

model AgentTrigger {
  id             String   @id @default(cuid())
  organizationId String
  agentId        String
  triggerEvent   String
  conditions     String? // serialized JSON, e.g. { "daysThreshold": 3 }
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fires        AgentTriggerFire[]

  @@index([organizationId])
  @@index([agentId])
  @@index([organizationId, triggerEvent])
  @@map("agent_triggers")
}

// One row per (agentTrigger, entity) pair. Used both as the cooldown ledger
// (lastTriggeredAt) and as the fire history shown on the Agent Automation tab.
model AgentTriggerFire {
  id              String   @id @default(cuid())
  organizationId  String
  agentTriggerId  String
  agentId         String
  entityType      String // "LEAD" | "STUDENT" | "CONVERSATION"
  entityId        String
  status          String   @default("SUCCESS") // "SUCCESS" | "FAILED" | "SKIPPED"
  errorMessage    String?
  lastTriggeredAt DateTime @default(now())
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentTrigger AgentTrigger @relation(fields: [agentTriggerId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentTriggerId, entityType, entityId])
  @@index([organizationId])
  @@index([agentId])
  @@index([entityType, entityId])
  @@map("agent_trigger_fires")
}

model Conversation {
  id              String    @id @default(cuid())
  agentId         String
  leadId          String?
  studentId       String?
  channel         String
  transcript      String
  outcome         String    @default("CONTINUED")
  costInPaise     Int?
  claimedByUserId String?
  claimedAt       DateTime?
  createdAt       DateTime  @default(now())

  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  claimedBy User?    @relation("ClaimedConversations", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([leadId])
  @@index([studentId])
  @@index([claimedByUserId])
  @@map("conversations")
}

// Durable retry queue for work that must not be silently dropped on a
// transient failure — currently lead ingestion and agent trigger webhook
// calls. Processed by /api/cron/process-jobs with exponential backoff.
model Job {
  id          String   @id @default(cuid())
  type        String
  payload     String
  status      String   @default("PENDING") // PENDING | PROCESSING | SUCCEEDED | FAILED
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  nextRunAt   DateTime @default(now())
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, nextRunAt])
  @@map("jobs")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  changesJson    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Activity {
  id              String   @id @default(cuid())
  organizationId  String
  entityType      String
  entityId        String
  type            String
  content         String?
  metadata        String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, entityType, entityId, createdAt])
  @@map("activities")
}

model Integration {
  id             String    @id @default(cuid())
  organizationId String
  type           String
  isEnabled      Boolean   @default(true)
  webhookSecret  String
  config         String?
  lastSyncAt     DateTime?
  lastSyncStatus String?
  lastError      String?
  leadsImported  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
  @@index([organizationId])
  @@index([webhookSecret])
  @@map("integrations")
}

model DocumentTemplate {
  id                String   @id @default(cuid())
  organizationId    String
  program           String
  requiredDocuments String // serialized JSON string array e.g. ["Aadhaar Card", "10th Certificate"]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, program])
  @@index([organizationId])
  @@map("document_templates")
}

model ErpSyncLog {
  id             String   @id @default(cuid())
  organizationId String
  direction      String
  action         String
  status         String
  entityId       String?
  payload        String?
  response       String?
  errorMessage   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, direction])
  @@index([organizationId, createdAt])
  @@map("erp_sync_logs")
}

model NotificationPreference {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  organizationId          String
  stalledLeadsInApp       Boolean  @default(true)
  stalledLeadsEmail       Boolean  @default(true)
  stalledLeadsWhatsapp    Boolean  @default(false)
  overduePaymentsInApp    Boolean  @default(true)
  overduePaymentsEmail    Boolean  @default(true)
  overduePaymentsWhatsapp Boolean  @default(false)
  escalationsInApp        Boolean  @default(true)
  escalationsEmail        Boolean  @default(false)
  escalationsWhatsapp     Boolean  @default(true)
  preferredChannel        String   @default("EMAIL") // "EMAIL" | "WHATSAPP"
  whatsappNumber          String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("notification_preferences")
}

model CustomFieldDefinition {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String // "LEAD" | "STUDENT"
  fieldKey       String
  label          String
  fieldType      String // "TEXT" | "NUMBER" | "DATE" | "SELECT" | "BOOLEAN"
  options        String? // JSON string array for SELECT options e.g. ["Option 1", "Option 2"]
  required       Boolean  @default(false)
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       CustomFieldValue[]

  @@unique([organizationId, entityType, fieldKey])
  @@index([organizationId])
  @@index([organizationId, entityType, isActive])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id                String   @id @default(cuid())
  organizationId    String
  entityType        String // "LEAD" | "STUDENT"
  entityId          String // Lead ID or Student ID
  fieldDefinitionId String
  value             String? // Stored as string, cast on read
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fieldDefinition CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([fieldDefinitionId, entityId])
  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@map("custom_field_values")
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#3b82f6") // Hex color e.g. #3b82f6, #10b981, #f59e0b
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityTags   EntityTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tags")
}

model EntityTag {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String // "LEAD" | "STUDENT"
  entityId       String // Lead ID or Student ID
  tagId          String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, entityId, tagId])
  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([tagId])
  @@map("entity_tags")
}

model DuplicateMatch {
  id                String   @id @default(cuid())
  organizationId    String
  entityType        String // "LEAD" | "STUDENT"
  primaryEntityId   String
  duplicateEntityId String
  matchedOn         String   @default("phone") // "phone" | "email"
  status            String   @default("PENDING") // "PENDING" | "MERGED" | "DISMISSED"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, primaryEntityId, duplicateEntityId])
  @@index([organizationId, entityType, status])
  @@index([organizationId, primaryEntityId])
  @@index([organizationId, duplicateEntityId])
  @@map("duplicate_matches")
}

model ScoringRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  field          String // "source" | "stage" | "daysInCurrentStage" | "daysSinceLastActivity" | "hasReplied" | "hasConversations" | custom field key
  operator       String // "EQUALS" | "NOT_EQUALS" | "GREATER_THAN" | "LESS_THAN" | "CONTAINS"
  value          String // comparison target value
  points         Int // positive or negative points, e.g. +20, -15
  enabled        Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, enabled])
  @@map("scoring_rules")
}

model SLAPolicy {
  id                   String   @id @default(cuid())
  organizationId       String
  source               String? // null indicates org-wide default fallback SLA, or enum LeadSource string
  respondWithinMinutes Int // e.g. 15, 30, 60, 120, 240
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, source])
  @@index([organizationId])
  @@map("sla_policies")
}

model PipelineTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String // e.g. "Default Admissions Pipeline", "Vocational Diploma Pipeline"
  program        String? // null indicates default fallback template for leads without specific program
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]

  @@unique([organizationId, program])
  @@index([organizationId])
  @@map("pipeline_templates")
}

model PipelineStage {
  id                   String   @id @default(cuid())
  pipelineTemplateId   String
  name                 String // e.g. "Inbound Inquiry", "Document Verification", "Seat Blocked"
  displayOrder         Int      @default(0)
  color                String   @default("#3b82f6") // Hex color e.g. "#3b82f6"
  requiresReasonOnExit Boolean  @default(false) // If true, exiting this stage prompts for a reason
  mapsToBucket         String // "COLD" | "WARM" | "HOT" | "CONVERTING" | "LOST"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  pipelineTemplate PipelineTemplate @relation(fields: [pipelineTemplateId], references: [id], onDelete: Cascade)
  leads            Lead[]

  @@index([pipelineTemplateId])
  @@index([pipelineTemplateId, displayOrder])
  @@map("pipeline_stages")
}

model MessageTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  channel        String // "EMAIL" | "SMS" | "WHATSAPP"
  subject        String? // Only for EMAIL channel
  body           String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, channel])
  @@map("message_templates")
}

// ── Batch & timetable management (feature 5) ──────────────────────────────
model Batch {
  id             String    @id @default(cuid())
  organizationId String
  name           String // e.g. "Data Science - Evening Batch A"
  program        String
  facultyUserId  String?
  startDate      DateTime
  endDate        DateTime?
  scheduleDays   String // JSON string array, e.g. ["MON","WED","FRI"]
  scheduleTime   String? // e.g. "18:00-19:30"
  capacity       Int?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  faculty           User?             @relation(fields: [facultyUserId], references: [id], onDelete: SetNull)
  students          Student[]
  attendanceRecords ClassAttendance[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("batches")
}

model ClassAttendance {
  id             String   @id @default(cuid())
  organizationId String
  batchId        String
  studentId      String
  date           DateTime
  status         String   @default("PRESENT") // "PRESENT" | "ABSENT" | "LATE"
  markedByUserId String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId, date])
  @@index([organizationId])
  @@index([studentId])
  @@index([batchId, date])
  @@map("class_attendance")
}

// ── Parent/Guardian portal (feature 3) ────────────────────────────────────
// A separate, lightweight credential — not a User row — scoped to exactly
// one Student. Authenticated through a dedicated NextAuth provider
// (lib/auth.ts "guardian-credentials") so a guardian session is clearly
// distinguishable from a staff session and can never reach staff-only APIs.
model Guardian {
  id             String   @id @default(cuid())
  organizationId String
  studentId      String
  name           String
  email          String
  phone          String?
  password       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([studentId])
  @@map("guardians")
}

// ── Free demo-class booking (feature 8) ───────────────────────────────────
model DemoSlot {
  id             String   @id @default(cuid())
  organizationId String
  startTime      DateTime
  endTime        DateTime
  capacity       Int      @default(1)
  bookedCount    Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     DemoBooking[]

  @@index([organizationId])
  @@index([organizationId, startTime])
  @@map("demo_slots")
}

model DemoBooking {
  id             String   @id @default(cuid())
  organizationId String
  demoSlotId     String
  leadId         String?
  name           String
  phone          String
  email          String?
  program        String?
  status         String   @default("SCHEDULED") // "SCHEDULED" | "COMPLETED" | "CANCELLED" | "NO_SHOW"
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  demoSlot     DemoSlot     @relation(fields: [demoSlotId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([demoSlotId])
  @@map("demo_bookings")
}

// ── Referral payout automation (feature 7) ────────────────────────────────
model ReferralPayout {
  id                String    @id @default(cuid())
  organizationId    String
  referrerStudentId String?
  referrerName      String
  referrerPhone     String
  referredLeadId    String?
  amount            Float
  status            String    @default("PENDING") // "PENDING" | "PAID" | "CANCELLED"
  upiVpa            String?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referrerStudent Student?     @relation("ReferrerStudent", fields: [referrerStudentId], references: [id], onDelete: SetNull)
  referredLead    Lead?        @relation("ReferredLead", fields: [referredLeadId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("referral_payouts")
}

// ── Admissions-season WhatsApp broadcasts (feature 6) ─────────────────────
model BroadcastCampaign {
  id              String    @id @default(cuid())
  organizationId  String
  name            String
  channel         String    @default("WHATSAPP")
  templateMessage String
  segmentType     String // "LEADS" | "STUDENTS"
  segmentFilter   String? // JSON filter, e.g. { "stage": "COLD" }
  status          String    @default("DRAFT") // "DRAFT" | "SENDING" | "SENT" | "FAILED"
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  optedOutSkipped Int       @default(0)
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("broadcast_campaigns")
}
