# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_edu_crm?schema=public"

# NextAuth Configuration
NEXTAUTH_SECRET="your-nextauth-secret-key-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# AI Agents — required for agents to actually generate replies (AI voice call
# simulation, the website chat widget). Without this, those features return a
# clear 503 instead of silently faking a conversation.
ANTHROPIC_API_KEY="sk-ant-..."
# Optional: USD->INR rate used only for the org-facing cost-per-conversation display.
AI_USD_TO_INR_RATE="83"

# Optional: 32-byte key (64 hex chars or 44-char base64) used to encrypt agent
# integration secrets (WhatsApp/voice provider tokens) at rest. Falls back to
# a key derived from NEXTAUTH_SECRET if unset.
ENCRYPTION_KEY=""

# Optional: shared, persistent rate limiting (Upstash Redis REST API). Without
# these, rate limits are tracked in-memory per server instance and reset on
# every redeploy — fine for one instance, not correct once you run more than
# one. Get free values at https://console.upstash.com.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Real billing (Stripe). Without these, checkout/billing-portal return a
# clear 503 instead of faking a successful payment — every org still gets a
# real 14-day trial on signup regardless of whether this is configured.
STRIPE_SECRET_KEY=""
# From the Stripe CLI (`stripe listen`) in dev, or your webhook endpoint's
# signing secret in the Stripe Dashboard in production.
STRIPE_WEBHOOK_SECRET=""

# Error monitoring (Sentry). Without these, errors only go to console.error
# (which nobody is watching in production) — this is a real no-op until set,
# not a stub. NEXT_PUBLIC_SENTRY_DSN is exposed to the browser bundle by
# design (Sentry DSNs are not secret) and is what client-side errors report to.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
